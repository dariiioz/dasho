# Port HTTP expose par Dasho. Choisissez librement : 5000, 5555, etc.
PORT=5555

# Chemin ABSOLU vers la base SQLite sur le serveur.
DATABASE_URL=/srv/dasho/data/dasho.db

# Activez ces options seulement si Dasho doit joindre des services du reseau interne
# ou des services utilisant des certificats TLS auto-signes.
ALLOW_PRIVATE_TARGETS=false
ALLOW_SELF_SIGNED_CERTIFICATES=false

# Laisse Dasho utiliser uniquement les favicons recuperees directement depuis les services.
ENABLE_EXTERNAL_FAVICON_SERVICE=false
